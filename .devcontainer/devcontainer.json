{
  "name": "Get Into Teaching Website",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      // libpq-dev/libvips/entr are app runtime deps. The rest are build
      // dependencies needed to compile native gems from source (nokogiri,
      // ffi, pg, psych, ...), which .bundle/config forces via
      // BUNDLE_FORCE_RUBY_PLATFORM and nokogiri's --use-system-libraries.
      "packages": "libpq-dev, libvips, entr, build-essential, pkg-config, libxml2-dev, libxslt1-dev, zlib1g-dev, libffi-dev, libyaml-dev"
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/ruby:1": {
      "version": "3.4.10"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24.13.0"
    },
    "ghcr.io/devcontainers/features/common-utils:1": {
      "username": "vscode",
      "uid": 1000,
      "gid": 1000,
      "installZsh": true,
      "installOhMyZsh": true,
      "configureZshAsDefaultShell": true,
      "upgradePackages": true
    }
  },
  // Marks that we are running inside the dev container, so the auto-start task
  // only launches the server here (and not when a developer opens the repo in
  // plain VS Code on their own machine).
  "containerEnv": {
    "IN_DEVCONTAINER": "true",
    // Let corepack download the pinned Yarn (packageManager in package.json)
    // without the interactive "Do you want to continue? [Y/n]" prompt that
    // otherwise hangs the non-interactive setup script.
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-tslint-plugin",
        "ms-vscode.vscode-types"
      ]
    }
  },
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // This can be used to network with other containers or the host.
  "forwardPorts": [2222, 3000, 6379],
  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": ".devcontainer/boot.sh"
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
