<div class="content">
  <%= render Content::TimedFinancialContentComponent.new(
    default: { text: "Details of financial support for courses starting in the 2027 to 2028 academic year will be released soon." },
  ) %>
  <%= render Content::TimedFinancialContentComponent.new(
    default: { text: "If you want to do postgraduate teacher training in England that leads to <a href='/train-to-be-a-teacher/what-is-qts'>qualified teacher status (QTS)</a>, you may be eligible for a bursary." },
    "2025": { text: "If you want to do postgraduate teacher training in England that leads to <a href='/train-to-be-a-teacher/what-is-qts'>qualified teacher status (QTS)</a>, you may be eligible for a bursary or scholarship." },
  ) %>
</div>

<h2 class="heading--box-gitlilac">
  <%= render Content::TimedFinancialContentComponent.new(
    format: :text,
    default: { text: "What are bursaries?" },
    "2025": { text: "What are bursaries and scholarships?" },
  ) %>
</h2>

<div class="content">
  <section class="col col-720">
    <%= render Content::TimedFinancialContentComponent.new(
      default: { partial: "content/funding-and-support/scholarships-and-bursaries/what_are_bursaries" },
      "2025": { partial: "content/funding-and-support/scholarships-and-bursaries/what_are_bursaries_and_scholarships" },
    ) %>
  </section>
  <section id="funding-widget">
    <%= render FundingWidgetComponent.new(
      @funding_widget,
      page_path(request.path.delete_prefix("/"), anchor: 'funding-widget'))
   %>
  </section>
</div>
