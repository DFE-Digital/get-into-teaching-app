<div class="row">
  <section class="col col-720">
    <h2 class="heading--box-gitlilac">How can I fund my teacher training?</h2>
    <div class="inset">
      <table class="first-column-headings right-aligned-values">
      <caption class="govuk-table__caption govuk-table__caption--m">Scholarship amounts for subjects where funding depends on your degree</caption>
  <thead>
          <tr>
            <th scope="col">Subject</th>
            <th scope="col">Scholarship</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Chemistry</td>
            <td><%= v :scholarships_chemistry %></td>
          </tr>
          <tr>
            <td>Computing</td>
            <td><%= v :scholarships_computing %></td>
          </tr>
          <tr>
            <td>Physics</td>
            <td><%= v :scholarships_physics %></td>
         </tr>
         </tbody>
</table>
<br>

<p> 
<%= link_to("Find out more about how to get a bursary or scholarship", page_path("funding-and-support/scholarships-and-bursaries")) %>.
</p>

<table class="first-column-headings right-aligned-values">
  <caption class="govuk-table__caption govuk-table__caption--m">
    Bursary amounts for subjects where funding depends on your degree
  </caption>

  <thead>
    <tr>
      <th scope="col">Subject</th>
      <th scope="col">Bursary for a relevant degree</th>
      <th scope="col">Bursary for any degree</th>
    </tr>
  </thead>

  <tbody>
    <tr>
      <td>Chemistry</td>
      <td><%= v :bursaries_postgraduate_chemistryrelevantdegree %></td>
      <td><%= v :bursaries_postgraduate_chemistryunrelateddegree %></td>
    </tr>
    <tr>
      <td>Computing</td>
      <td><%= v :bursaries_postgraduate_computingrelevantdegree %></td>
      <td><%= v :bursaries_postgraduate_computingunrelateddegree %></td>
    </tr>
    <tr>
      <td>Design and technology</td>
      <td><%= v :bursaries_postgraduate_designandtechnologyrelevantdegree %></td>
      <td><%= v :bursaries_postgraduate_designandtechnologyunrelateddegree %></td>
    </tr>
    <tr>
      <td>Maths</td>
      <td><%= v :bursaries_postgraduate_mathsrelevantdegree %></td>
      <td><%= v :bursaries_postgraduate_mathsunrelateddegree %></td>
    </tr>
    <tr>
      <td>Physics</td>
      <td><%= v :bursaries_postgraduate_physicsrelevantdegree %></td>
      <td><%= v :bursaries_postgraduate_physicsunrelateddegree %></td>
    </tr>
  </tbody>
</table>
<br>

<table class="first-column-headings right-aligned-values">
  <caption class="govuk-table__caption govuk-table__caption--m">
    Scholarship and bursary amounts for subjects that do not require a relevant degree
  </caption>

  <thead>
    <tr>
      <th scope="col">Subject</th>
      <th scope="col">Scholarship</th>
      <th scope="col">Bursary</th>
    </tr>
  </thead>

  <tbody>
    <tr>
      <td>Languages<br>(French, German and Spanish only)</td>
      <td><%= v :scholarships_languagesfrenchgermanspanish %></td>
      <td><%= v :bursaries_postgraduate_languagesfrenchgermanspanish %></td>
    </tr>
    <tr>
      <td>Languages<br>(all other languages, including ancient languages)</td>
      <td></td>
      <td><%= v :bursaries_postgraduate_languagesother %></td>
    </tr>
    <tr>
      <td>Biology</td>
      <td></td>
      <td><%= v :bursaries_postgraduate_biology %></td>
    </tr>
    <tr>
      <td>Geography</td>
      <td></td>
      <td><%= v :bursaries_postgraduate_geography %></td>
    </tr>
    <tr>
      <td>Music</td>
      <td></td>
      <td><%= v :bursaries_postgraduate_music %></td>
    </tr>
    <tr>
      <td>Religious education (RE)</td>
      <td></td>
      <td><%= v :bursaries_postgraduate_religiouseducation %></td>
    </tr>
  </tbody>
</table>

</div>
</section>
</div>

  <section class="col col-720">
    <h2 class="heading--box-gitlilac">More financial support</h2>

    <div class="inset">
      <p>
        You can get funding for your teacher training, even if you've had student finance before.
      </p>

      <p><%= link_to("Find out more about how you could fund your training", page_path("funding-and-support")) %>.</p>
    </div>
  </section>
</div>
