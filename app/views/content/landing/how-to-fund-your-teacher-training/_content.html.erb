<div class="row">
  <section class="col col-720">
    <h2 class="heading--box-gitlilac">How can I fund my teacher training?</h2>
    <div class="inset">
      <%= render Content::TimedFinancialContentComponent.new(
        default: {
          text: "Details of financial support for courses starting in the 2027 to 2028 academic year will be released soon.",
        },
        "2025": {
          partial: "content/landing/how-to-fund-your-teacher-training/available_bursaries_table",
        }
      ) %>

      <%= render Content::TimedFinancialContentComponent.new(
        default: {
          text: "<a href=\"/funding-and-support/scholarships-and-bursaries\">Find out more about how to get a bursary</a>.",
        },
        "2025": {
          text: "<a href=\"/funding-and-support/scholarships-and-bursaries\">Find out more about how to get a bursary or scholarship</a>.",
        }
      ) %>
    </div>
  </section>

  <section class="col col-720">
    <h2 class="heading--box-gitlilac">More financial support</h2>

    <div class="inset">
      <%= render Content::TimedFinancialContentComponent.new(
        default: {
          text: "You can get funding for your teacher training, even if you've had student finance before.",
        },
        "2025": {
          partial: "content/landing/how-to-fund-your-teacher-training/more_finacial_support",
        }
      ) %>

      <p><%= link_to("Find out more about how you could fund your training", page_path("funding-and-support")) %>.</p>
    </div>
  </section>
</div>
